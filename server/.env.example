# ========================================
# HeritageTrace AI — Environment Variables
# ========================================
# Copy this file to .env and fill in your values.

# MongoDB connection string
# Set the Atlas connection string from Atlas > Connect > Drivers.
# Keep credentials in server/.env; do not commit that file.
MONGODB_URI=

# Legacy variable name is supported if already configured.
# MONGO_URI=

# Optional Mongo connection timeout in milliseconds (default: 8000)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# Server port
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Public base URL used for saved /uploads image links (set for non-local deployments)
# SERVER_PUBLIC_URL=http://localhost:5000

# AI feature extraction and persistent visual index
AI_SERVICE_URL=http://localhost:8001
